# ─── Cloud mode (Supabase) ───────────────────────────────────────────────
# Without these, the app runs in "device mode": everything works, data stays in the browser,
# and real gifts / push notifications / cross-device sync are disabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose

# ADMIN_EMAILS: Ewan's address. Admin rights ALSO need the "admin" role set in Supabase (see /setup).
# ALLOWED_EMAILS: addresses Ewan may invite (Isabelle). Never put an admin address here.
# For Preview testing, use a test address in ALLOWED_EMAILS so Isabelle's real account stays untouched.
ADMIN_EMAILS=ewan@example.com
ALLOWED_EMAILS=isabelle@example.com

# Secrets (at least 32 random characters each). Generate with: openssl rand -base64 48
APP_SECRET=
REWARD_ENCRYPTION_KEY=   # encrypts real Robux codes (AES-256-GCM). Never change it once codes exist.

# ─── Web push (optional) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ewan@example.com

# Protects /api/cron/dispatch (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=
